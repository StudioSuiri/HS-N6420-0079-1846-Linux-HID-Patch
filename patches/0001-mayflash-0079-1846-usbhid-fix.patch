diff --git a/drivers/hid/usbhid/hid-core.c b/drivers/hid/usbhid/hid-core.c
index e8428ac..23d91b1 100644
--- a/drivers/hid/usbhid/hid-core.c
+++ b/drivers/hid/usbhid/hid-core.c
@@ -1049,7 +1049,10 @@ static int usbhid_parse(struct hid_device *hid)
 	if (!rdesc)
 		return -ENOMEM;
 
-	hid_set_idle(dev, interface->desc.bInterfaceNumber, 0, 0);
+	if (!(le16_to_cpu(dev->descriptor.idVendor) == 0x0079 && le16_to_cpu(dev->descriptor.idProduct) == 0x1846))
+		hid_set_idle(dev, interface->desc.bInterfaceNumber, 0, 0);
+	else
+		dev_info(&dev->dev, "usbhid: skipping hid_set_idle for 0079:1846\n");
 
 	ret = hid_get_class_descriptor(dev, interface->desc.bInterfaceNumber,
 			HID_DT_REPORT, rdesc, rsize);
@@ -1059,6 +1062,22 @@ static int usbhid_parse(struct hid_device *hid)
 		goto err;
 	}
 
+	if (le16_to_cpu(dev->descriptor.idVendor) == 0x0079 &&
+	    le16_to_cpu(dev->descriptor.idProduct) == 0x1846 && rsize == 198) {
+		u8 *rdesc4 = kmalloc(396, GFP_KERNEL);
+		if (rdesc4) {
+			/* Copy report 1 (99 bytes) to report 1 and 3 */
+			memcpy(rdesc4, rdesc, 99);
+			memcpy(rdesc4 + 99, rdesc + 99, 99); /* Report 2 */
+			memcpy(rdesc4 + 198, rdesc, 99);     /* Report 3 */
+			rdesc4[198 + 7] = 0x03;              /* Report ID 3 */
+			memcpy(rdesc4 + 297, rdesc, 99);     /* Report 4 */
+			rdesc4[297 + 7] = 0x04;              /* Report ID 4 */
+			kfree(rdesc);
+			rdesc = rdesc4;
+			rsize = 396;
+			dev_info(&dev->dev, "usbhid: expanded 0079:1846 descriptor to 4 ports (396 bytes)\n");
+		}
 	}
 	ret = hid_parse_report(hid, rdesc, rsize);
 	kfree(rdesc);
@@ -1072,6 +1091,12 @@ static int usbhid_parse(struct hid_device *hid)
 			"%u unsupported optional hid class descriptors\n",
 			(int)(hdesc->bNumDescriptors - 1));
 
+	if (le16_to_cpu(dev->descriptor.idVendor) == 0x0079 &&
+	    le16_to_cpu(dev->descriptor.idProduct) == 0x1846) {
+		quirks |= HID_QUIRK_ALWAYS_POLL;
+		dev_info(&dev->dev, "usbhid: set HID_QUIRK_ALWAYS_POLL for 0079:1846\n");
+	}
+
 	hid->quirks |= quirks;
 
 	return 0;
@@ -1578,7 +1603,8 @@ static int hid_post_reset(struct usb_interface *intf)
 	clear_bit(HID_RESET_PENDING, &usbhid->iofl);
 	clear_bit(HID_CLEAR_HALT, &usbhid->iofl);
 	spin_unlock_irq(&usbhid->lock);
-	hid_set_idle(dev, intf->cur_altsetting->desc.bInterfaceNumber, 0, 0);
+	if (!(le16_to_cpu(dev->descriptor.idVendor) == 0x0079 && le16_to_cpu(dev->descriptor.idProduct) == 0x1846))
+		hid_set_idle(dev, intf->cur_altsetting->desc.bInterfaceNumber, 0, 0);
 
 	hid_restart_io(hid);
 
